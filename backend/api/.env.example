# Telemetry API Server Environment Configuration Template
NODE_ENV=development
PORT=3000
# For local system only, use 127.0.0.1.
# To access from a separate system on the network, set HOST=0.0.0.0 (or your LAN IP, e.g., 192.168.1.50)
HOST=127.0.0.1

# Telemetry Simulator Parameters
TELEMETRY_INTERVAL_MS=1000
TELEMETRY_VARIATION_CYCLES=5
TELEMETRY_RECOVERY_CYCLES=5
TELEMETRY_RECOVERY_FACTOR=0.45
TELEMETRY_HISTORY_CAPACITY=100
TELEMETRY_VARIATION_MAX_FRACTION=0.10

# Security Configuration
API_SECRET_KEY=your-strong-secret-key-here
# If running on separate systems, append the client IP / origin here (e.g., http://192.168.1.100:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

